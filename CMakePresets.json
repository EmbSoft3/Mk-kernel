{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/CMake/arm-none-eabi-toolchain.cmake",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "release-eval2",
      "displayName": "Release — EVAL2",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BOARD": "EVAL2"
      }
    },
    {
      "name": "debug-eval2",
      "displayName": "Debug — EVAL2",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BOARD": "EVAL2"
      }
    },
    {
      "name": "release-disco",
      "displayName": "Release — DISCO_REV_C",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BOARD": "DISCO_REV_C"
      }
    },
    {
      "name": "debug-disco",
      "displayName": "Debug — DISCO_REV_C",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BOARD": "DISCO_REV_C"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release-eval2",
      "configurePreset": "release-eval2"
    },
    {
      "name": "debug-eval2",
      "configurePreset": "debug-eval2"
    },
    {
      "name": "release-disco",
      "configurePreset": "release-disco"
    },
    {
      "name": "debug-disco",
      "configurePreset": "debug-disco"
    }
  ]
}